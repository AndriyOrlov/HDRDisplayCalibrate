<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HDRDisplayCalibrate</AssemblyName>
    <RootNamespace>HDRDisplayCalibrate</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>WPF0001;CA1416</NoWarn>
    <Version>0.2.0</Version>
    <Authors>Andrii Orlov (DeadSue)</Authors>
    <Copyright>Copyright 2026 Andrii Orlov (DeadSue)</Copyright>
    <Product>HDRDisplayCalibrate</Product>
    <Description>SDR and HDR display calibration for Windows with ordinary colorimeters (ArgyllCMS backend, native ICC and MHC2 profiles)</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="i18n\*.json" LogicalName="HDRDisplayCalibrate.i18n.%(Filename).json" />
  </ItemGroup>
</Project>

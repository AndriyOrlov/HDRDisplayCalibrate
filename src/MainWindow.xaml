<Window x:Class="HDRDisplayCalibrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRDisplayCalibrate" Width="1200" Height="820" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="36" ResizeBorderThickness="6" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="app.ico" Width="16" Height="16" Margin="0,0,10,0"/>
            <TextBlock Text="HDRDisplayCalibrate" FontSize="12"/>
            <TextBlock x:Name="TitleDisplay" FontSize="12" Foreground="#9A9A9A" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="Nav" Grid.Row="1" Margin="8,4,4,8" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"/>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" CornerRadius="8" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <ContentControl x:Name="Host"/>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#C8C8C8"/>
            <ProgressBar x:Name="StatusBar" Grid.Column="1" Height="4" Margin="12,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Padding="12,4" Click="Cancel_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
